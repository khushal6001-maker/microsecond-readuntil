+    // DWELL-TIME VARIABILITY.
+    //
+    // Icarust emits exactly `samples_per_base` samples for every k-mer, so every
+    // simulated read translocates at a perfectly constant rate. Real pores do not: the
+    // dwell time per k-mer is variable and right-skewed. The constant-rate assumption is
+    // invisible to a basecaller-based client, but it is decisive for any tool that
+    // segments raw signal by time, because fixed-width segmentation is exactly correct
+    // under constant dwell and degrades as soon as dwell varies. A client can therefore
+    // look accurate against Icarust and fail on a sequencer.
+    //
+    // ICARUST_DWELL_CV sets the coefficient of variation of a lognormal dwell about
+    // `samples_per_base`. Lognormal because dwell is positive and right-skewed, and it is
+    // the long holds that do the damage. Published R10 variability is roughly 0.3-0.5.
+    //
+    // Unset or 0 reproduces the original fixed-count behaviour exactly, so existing
+    // results are unaffected. An environment variable rather than a config field keeps
+    // this a minimal, revertible change to a third-party simulator; a config option is
+    // what an upstream patch should use.
+    let dwell_cv: f64 = std::env::var("ICARUST_DWELL_CV")
+        .ok()
+        .and_then(|v| v.parse::<f64>().ok())
+        .filter(|v| v.is_finite() && *v > 0.0)
+        .unwrap_or(0.0);
+    let dwell_dist: Option<LogNormal<f64>> = if dwell_cv > 0.0 {
+        let sigma2 = (1.0 + dwell_cv * dwell_cv).ln();
+        let mu = (samples_per_base as f64).ln() - 0.5 * sigma2;
+        match LogNormal::new(mu, sigma2.sqrt()) {
+            Ok(d) => {
+                info!(
+                    "dwell variability ENABLED: lognormal CV {dwell_cv} about \
+                     {samples_per_base} samples/base"
+                );
+                Some(d)
+            }
+            Err(e) => {
+                info!("dwell variability requested but rejected ({e}); using fixed dwell");
+                None
+            }
+        }
+    } else {
+        None
+    };
+
